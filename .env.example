# ===================================================
# FLEXO LIFESTYLE - ENVIRONMENT CONFIGURATION
# ===================================================

# Brand Info
NEXT_PUBLIC_BRAND_NAME="FLEXO LIFESTYLE"
NEXT_PUBLIC_BRAND_TAGLINE="Wear it. Flaunt it. Flex it."

# Payments & Contact (Free-tier UPI & WhatsApp direct checkout)
# Replace with your actual UPI ID and WhatsApp Number (with country code, e.g., 919876543210)
NEXT_PUBLIC_UPI_ID="flexo@upi"
NEXT_PUBLIC_UPI_NAME="Flexo Lifestyle"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"

# Supabase (Free tier)
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Admin Authentication
# Email and password allowed to access the /admin panel
ADMIN_EMAIL="admin@flexolifestyle.com"
NEXT_PUBLIC_ADMIN_PASSWORD="admin123"

# Site URL (for SEO OpenGraph and metadata)
NEXT_PUBLIC_SITE_URL="http://   :3000"
